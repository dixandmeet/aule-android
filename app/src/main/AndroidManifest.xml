<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ACCESS_*_LOCATION, FOREGROUND_SERVICE*, POST_NOTIFICATIONS, VIBRATE,
         WAKE_LOCK et le service lui-même viennent de :core:location.
         Ils ne s'activent qu'avec LocationPurpose.NAVIGATING ou ON_DUTY. -->

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- `enableOnBackInvokedCallback` n'a d'effet qu'à partir de l'API 33 : le
         geste de retour prédictif n'existe pas en dessous, et l'attribut y est
         simplement ignoré. Lint le signale, c'est attendu — d'où le `tools:ignore`,
         qui dit qu'on l'a lu plutôt que de le laisser s'accumuler. -->
    <application
        android:name=".AuleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:ignore="UnusedAttribute"
        android:theme="@style/Theme.Aule">

        <!-- Portrait seul : tout le cadrage de la carte se calcule sur la hauteur
             (décalage du puck dans le tiers bas, détentes du volet, marges de
             contenu). Le Flutter Pro pose le même verrou, pour la même raison.

             Lint le signale deux fois, et les deux fois il a raison de le dire :
             `LockedOrientationActivity` parce qu'un verrou prive l'usager d'un
             choix, `DiscouragedApi` parce qu'Android 16 cesse de l'honorer sur
             les grands écrans. C'est assumé, et le coût en est mesuré : le
             cadrage lit la hauteur **réelle** de la vue
             (`MapController.viewportHeightDp`), donc un paysage forcé donnerait
             un cadre dégradé — plus bas, moins de route devant — et non un
             cadre faux. À rouvrir le jour où une tablette entre dans le parc.
 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:configChanges="keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Aule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Même schéma que Flutter Pro : il est déjà dans les Redirect
                 URLs GoTrue. Les deux apps coexistent sur un appareil ; le
                 système propose le sélecteur. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="io.aule.pro"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
