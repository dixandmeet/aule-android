<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème clair. Le fond est la surface Aule pleine (0xFFFFFF), pas le blanc du
      système : sans cela, la fenêtre peint un fond étranger avant que Compose ne
      dessine, et le démarrage clignote.

      Parent framework plutôt qu'AppCompat : l'application est en Compose pur et
      n'a aucune raison de tirer AppCompat pour un thème.
    -->
    <style name="Theme.Aule" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/aule_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
