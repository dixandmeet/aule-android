<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Thème clair. Le fond est la surface Aule pleine (0xFFFFFF), pas le blanc du
      système : sans cela, la fenêtre peint un fond étranger avant que Compose ne
      dessine, et le démarrage clignote.

      Exception assumée à « tout est Material 3 » : ce thème n'hérite pas de
      Theme.Material3, qui vit dans la bibliothèque Material Components pour les
      Vues. L'application est en Compose pur — le design system Material 3 y est
      fourni par androidx.compose.material3 et posé par AuleTheme. Tirer une
      dépendance Vues entière pour ce seul héritage ajouterait des milliers de
      styles inutilisés au paquet sans rien changer à l'écran, puisque ce thème
      ne sert qu'à peindre la fenêtre avant la première image de Compose.

      Ce que ce thème doit garantir, il le garantit : fond aligné sur
      MaterialTheme.colorScheme.surface, barres système transparentes pour le
      bord-à-bord, et bascule clair/sombre par qualificateur de ressource.
    -->
    <style name="Theme.Aule" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/aule_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
