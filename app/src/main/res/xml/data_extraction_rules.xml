<?xml version="1.0" encoding="utf-8"?>
<!--
  Rien de cette application ne part en sauvegarde cloud ni en transfert
  d'appareil. Elle ne détient que des préférences reconstructibles et, plus tard,
  une session conducteur — qui ne doit surtout pas voyager d'un téléphone à
  l'autre à l'insu de son porteur.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
